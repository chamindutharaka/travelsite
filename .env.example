# Ceylon Holidays Environment Variables

# Production Site URL (used for canonical URLs, Open Graph, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=https://travel.chamindu.com

# Resend Email Notifications (used by /api/plan and /api/contact)
RESEND_API_KEY=
TO_EMAIL=hello@travel.chamindu.com
CONTACT_EMAIL_TO=hello@travel.chamindu.com

# WhatsApp Number (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_PHONE=94702156828

# Optional Analytics (set either or both)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
